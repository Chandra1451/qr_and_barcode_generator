# =============================================================================
# Universal QR & Barcode Generator - LiteSpeed / Apache Production Config
# Engineered specifically for Hostinger Business Shared Web Hosting
# =============================================================================

# 1. LiteSpeed Enterprise In-Memory Page & Asset Caching
<IfModule LiteSpeed>
  CacheLookup on
  CacheEngine on public
  CacheMaxAge 86400
</IfModule>

# 2. Force HTTPS (Strict SSL) & Security Canonicalization
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Single-Hop Strict HTTPS & Canonical Host Redirection (Eliminates Multiple Redirects)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.universalcodemaker\.com$ [NC]
  RewriteRule ^(.*)$ https://universalcodemaker.com/$1 [L,R=301]

  # Block direct access to hidden files/directories (e.g. .git, .env)
  RewriteRule ^\..* - [F,L]

  # Development-only folders stay in git but are not part of the public site
  RewriteRule ^(tools|tests)(/|$) - [R=404,L]
</IfModule>

# 3. Default Character Encoding & Extended MIME Types
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml             .svg .svgz
  AddType font/woff2                .woff2
  AddType font/woff                 .woff
  AddType application/javascript    .js .mjs
  AddType text/plain                .txt
  AddType text/xml                  .xml
</IfModule>

# 4. Gzip & Brotli Deflate Compression (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# 5. Aggressive Browser Caching (mod_expires & mod_headers)
<IfModule mod_expires.c>
  ExpiresActive On

  # Immutable Assets (CSS, JS, Fonts, Images) - 1 Year Cache
  ExpiresByType text/css                     "access plus 1 year"
  ExpiresByType application/javascript       "access plus 0 seconds"
  ExpiresByType text/javascript              "access plus 0 seconds"
  ExpiresByType font/woff2                   "access plus 1 year"
  ExpiresByType font/woff                    "access plus 1 year"
  ExpiresByType font/ttf                     "access plus 1 year"
  ExpiresByType image/svg+xml                "access plus 1 year"
  ExpiresByType image/png                    "access plus 1 year"
  ExpiresByType image/webp                   "access plus 1 year"
  ExpiresByType image/jpeg                   "access plus 1 year"
  ExpiresByType image/x-icon                 "access plus 1 year"

  # Web Manifest - 1 Week
  ExpiresByType application/manifest+json    "access plus 1 week"

  # HTML Documents - 1 Hour
  ExpiresByType text/html                    "access plus 1 hour"

  # Search & AI Directive Files - 1 Day
  ExpiresByType text/plain                   "access plus 1 day"
  ExpiresByType text/xml                     "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Cache Header for Static Assets
  # (CSS is linked with ?v= on every page, so bump that version whenever a stylesheet changes)
  <FilesMatch "\.(css|svg|woff2|woff|ttf|png|webp|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # JavaScript: always revalidate (cheap 304 when unchanged). A cached copy of an older
  # module under the same URL made new controls do nothing, or broke module imports, for
  # returning visitors. Imports also carry ?v= (tools/bump-js-version.mjs) as a second guard.
  <FilesMatch "\.(js|mjs)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # HTML Files Must Revalidate
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Modern HTTP Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 6. Block Sensitive & Planning File Extensions (Defense in Depth)
<FilesMatch "(^\.env|\.(env|sql|md|log|sh|bat|yml|yaml|json\.lock|bak|config|dist|git))$">
  Require all denied
</FilesMatch>

# 7. Disable Directory Listing
Options -Indexes

# 8. Friendly 404 Error Page
ErrorDocument 404 /404.html
